# Telegram BotFather token
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Target channel — numeric ID (e.g. -1001234567890) or @username
CHANNEL_ID=@your_channel_username

# Twitter / X API credentials (Developer Portal → App → Keys and tokens)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret

# Runtime mode: polling (Ubuntu/local) | webhook (Vercel)
RUN_MODE=polling

# Required when RUN_MODE=webhook — full public HTTPS URL Telegram will call
# Example: https://your-app.vercel.app/api/webhook
WEBHOOK_URL=

# Optional but recommended — random secret Telegram sends as
# X-Telegram-Bot-Api-Secret-Token (set the same value in Vercel env)
WEBHOOK_SECRET=

# Local HTTP port (only if you self-host a webhook listener)
PORT=3000
