[Unit]
Description=ChannelX Telegram → Twitter reposter
Documentation=https://github.com/OWNER/channelx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=channelx
Group=channelx
WorkingDirectory=/opt/channelx
EnvironmentFile=/opt/channelx/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/channelx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

# Logs → journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=channelx

[Install]
WantedBy=multi-user.target
